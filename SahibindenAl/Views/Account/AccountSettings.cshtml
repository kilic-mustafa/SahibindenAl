@model SahibindenAl.Models.User

@{
    ViewData["Title"] = "Hesap Bilgilerini Güncelle";
    Layout = "~/Views/Shared/_LayoutWithoutSearch.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="mb-4">
                <h3 class="text-center px-4 py-2 rounded shadow-sm" style="color: rgb(0, 0, 0); background-color: #F8F9FA;">
                    Hesap Ayarları
                </h3>
            </div>

            <div class="card border-0 shadow-lg" style="border-radius: 15px;">
                <div class="card-body p-5">
                    <form asp-action="UpdateAccount" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="row mb-3">
                            <label asp-for="FirstName" class="col-sm-4 col-form-label fw-bold">Ad:</label>
                            <div class="col-sm-8">
                                <input asp-for="FirstName" class="form-control" placeholder="Adınızı giriniz" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label asp-for="LastName" class="col-sm-4 col-form-label fw-bold">Soyad:</label>
                            <div class="col-sm-8">
                                <input asp-for="LastName" class="form-control" placeholder="Soyadınızı giriniz" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label asp-for="UserName" class="col-sm-4 col-form-label fw-bold">Kullanıcı Adı:</label>
                            <div class="col-sm-8">
                                <input asp-for="UserName" class="form-control" />
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label asp-for="Email" class="col-sm-4 col-form-label fw-bold">E-posta:</label>
                            <div class="col-sm-8">
                                <input asp-for="Email" class="form-control" type="email" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label asp-for="PhoneNumber" class="col-sm-4 col-form-label fw-bold">Telefon:</label>
                            <div class="col-sm-8">
                                <input asp-for="PhoneNumber" class="form-control" placeholder="05xx xxx xx xx" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <label class="col-sm-4 col-form-label fw-bold text-muted">Kayıt Tarihi:</label>
                            <div class="col-sm-8">
                                <input value="@TimeZoneInfo.ConvertTimeFromUtc(Model.CreatedAt, TimeZoneInfo.FindSystemTimeZoneById("Turkey Standard Time")).ToString("dd.MM.yyyy")" class="form-control bg-light" readonly />
                            </div>
                        </div>

                        <hr />

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="submit" class="btn btn-primary px-5 shadow-sm" style="border-radius: 8px;">
                                <i class="fas fa-save me-2"></i>Değişiklikleri Kaydet
                            </button>
                        </div>
                    </form>
                    </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}