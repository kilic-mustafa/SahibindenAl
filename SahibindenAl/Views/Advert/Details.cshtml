@model SahibindenAl.Models.Advert


@if (Model == null)
{
    <div class="container mt-4">
        <div class="alert alert-danger">
            Ilan bulunamadı.
        </div>
    </div>
    return;
}

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    
    @Html.AntiForgeryToken()

    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
        <h4>@Model.Title</h4>
        
        <div class="d-flex align-items-center gap-2">   
            @if (User?.Identity?.IsAuthenticated == true)
            {
                <button id="btnFavorite" class="btn mb-0" style="width: 165px;"
                        onclick="toggleFavorite(@Model.Id)">
                    <i class="fa fa-heart"></i> ★ Favorilerime Ekle
                </button>
            }
            else
            {
                <a href="@Url.Action("Login", "Account", new { returnUrl = Url.Action("Details", "Advert", new { id = Model.Id }) })" 
                   class="btn mb-0" style="width: 165px;">
                    <i class="fa fa-heart"></i> ★ Favorilerime Ekle
                </a>
            }
            <button class="btn mb-0" style="width: 90px;">
                <i class="fa fa-print"></i> ⎙ Yazdır
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div id="advertCarousel" class="carousel slide mb-4" data-bs-ride="carousel">
                
                <div class="carousel-indicators">
                    @if (Model.AdvertImages != null)
                    {
                        @for (int i = 0; i < Model.AdvertImages.Count; i++)
                        {
                            <button type="button" data-bs-target="#advertCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></button>
                        }
                    }
                </div>

                <div class="carousel-inner" style="height: 496.5px; background-color: #000;">
                    @{ int index = 0; }
                    @if (Model.AdvertImages != null)
                    {
                        @foreach (var img in Model.AdvertImages)
                        {
                            <div class="carousel-item @(index == 0 ? "active" : "")" style="height: 100%;">
                                <img src="@img.ImageUrl" class="d-block w-100" alt="İlan Resmi" style="height: 100%; object-fit: contain;">
                            </div>
                            index++;
                        }
                    }
                    
                    @if(Model.AdvertImages == null || Model.AdvertImages.Count == 0)
                    {
                        <div class="carousel-item active" style="height: 100%; display:flex; align-items:center; justify-content:center;">
                            <span class="text-white">Görsel Yok</span>
                        </div>
                    }
                </div>

                <button class="carousel-control-prev" type="button" data-bs-target="#advertCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Önceki</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#advertCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Sonraki</span>
                </button>
            </div>
        </div>

        <div class="col-md-4">

            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">

                <div class="card p-2 border-0 shadow-sm text-center">
                    <span class="fs-4 text-primary fw-bold">@Model.Price.ToString("N0") TL</span>
                </div>

                <div class="card p-2 border-0 shadow-sm text-center">
                    <span class="fs-7 text-primary">％ Kredi Teklifi Al</span>
                </div>
            </div>

            <div class="card shadow-sm mb-3">
                <div class="card-header bg-white fw-bold">Satıcı Bilgileri</div>
                <div class="card-body">
                    <h5 class="card-title">@Model.User?.FirstName @Model.User?.LastName</h5>
                    <p class="card-subtitle mb-2 text-muted">Hesap açma tarihi: @Model.User?.CreatedAt.ToString("MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</p>

                    @if (!string.IsNullOrEmpty(Model.User?.PhoneNumber))
                    {
                        <a href="tel:@Model.User.PhoneNumber" class="btn btn-outline-success w-100 mt-2">
                            <i class="fa fa-phone"></i> Cep ( @Model.User.PhoneNumber )
                        </a>
                    }
                    
                    <button class="btn btn-primary w-100 mt-2 mb-3">Mesaj Gönder</button>
                </div>
            </div>


            <div class="card mb-3 shadow-sm">

                <div class="card-body">
                    <ul class="list-unstyled mb-2">
                        <li class="d-flex justify-content-between mb-2">
                            <span class="text-muted">İlan No</span>
                            <span class="fw-bold text-danger">@Model.Id</span>
                        </li>
                        <li class="d-flex justify-content-between mb-2">
                            <span class="text-muted">İlan Tarihi</span>
                            <span>@Model.CreatedDate.ToString("dd MMMM yyyy")</span>
                        </li>
                        <li class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Kategori</span>
                            <span class="text-primary">
                                @Model.Category?.ParentCategory?.Name / @Model.Category?.Name
                            </span>
                        </li>
                        <li class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Konum</span>
                            <span>@Model.City?.Name / @Model.District?.Name</span>
                        </li>
                    </ul>
                </div>
            </div>
        

        </div>

        <div class="col-12">
            <ul class="nav nav-tabs sahibinden-tabs border-0 mb-0" id="ilanTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-bold rounded-top" 
                            id="detay-tab" data-bs-toggle="tab" data-bs-target="#detay" type="button" role="tab">
                        İlan Detayları
                    </button>
                </li>
                
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-bold rounded-top" 
                            id="konum-tab" data-bs-toggle="tab" data-bs-target="#konum" type="button" role="tab">
                        Konumu
                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-bold rounded-top" 
                            id="teknik-tab" data-bs-toggle="tab" data-bs-target="#teknik" type="button" role="tab">
                        Teknik Özellikler
                    </button>
                </li>
            </ul>
            
            <div class="tab-content" id="ilanTabContent">
                
                <div class="tab-pane fade show active" id="detay" role="tabpanel">
                    <div class="card rounded-0 border-top-0">
                        <div class="card-header fw-bold bg-light border-bottom">Açıklama</div>
                        <div class="card-body">
                            <p style="white-space: pre-wrap;">@Model.Description</p>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="konum" role="tabpanel">
                    <div class="card rounded-0 border-top-0 shadow-sm p-0">
                        <div class="card-body p-0">
                            <div class="ratio ratio-21x9">
                                <iframe 
                                    width="100%" 
                                    height="100%" 
                                    frameborder="0" 
                                    scrolling="no" 
                                    marginheight="0" 
                                    marginwidth="0" 
                                    src="https://maps.google.com/maps?q=@(Model.City)%20@(Model.District)&t=&z=13&ie=UTF8&iwloc=&output=embed">
                                </iframe>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="teknik" role="tabpanel">
                    <div class="card rounded-0 border-top-0">
                        <div class="card-body p-0">
                            <table class="table table-striped table-hover mb-0">
                                <tbody>
                                @{  
                                    var filledFields = Model.AdvertPropertyValues?
                                                        .Where(p => !string.IsNullOrWhiteSpace(p.Value))
                                                        .ToList();
                                }
                                    @if (filledFields != null && filledFields.Any())
                                    {
                                        foreach (var prop in filledFields)
                                        {
                                            <tr>
                                                @if (@prop.PropertyKey?.Name == "Kimden") 
                                                    if(prop.Value == "Sahibinden")
                                                    {
                                                        <td class="fw-bold ps-3" style="width: 40%;">@prop.PropertyKey?.Name</td>
                                                        <td class="text-danger">@prop.Value</td>
                                                    }
                                                    else{
                                                        <td class="fw-bold ps-3" style="width: 40%;">@prop.PropertyKey?.Name</td>
                                                        <td class>@prop.Value</td>
                                                    }
                                                else if (@prop.PropertyKey?.Name == "Motor Gücü (hp)") {
                                                    <td class="fw-bold ps-3" style="width: 40%;">@prop.PropertyKey?.Name</td>
                                                    <td>@prop.Value hp</td>
                                                }
                                                else if (@prop.PropertyKey?.Name == "Motor Hacmi (cc)") {
                                                    <td class="fw-bold ps-3" style="width: 40%;">@prop.PropertyKey?.Name</td>
                                                    <td>@prop.Value cc</td>
                                                }
                                                else if (@prop.PropertyKey?.Name == "KM") {
                                                    <td class="fw-bold ps-3" style="width: 40%;">@prop.PropertyKey?.Name</td>
                                                    <td>@(int.Parse(prop.Value!).ToString("N0", new System.Globalization.CultureInfo("tr-TR")))</td>
                                                }
                                                else{
                                                <td class="fw-bold ps-3" style="width: 40%;">@prop.PropertyKey?.Name</td>
                                                <td>@prop.Value</td>
                                                }
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="2" class="text-muted text-center p-3">Belirtilen özellik yok.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function toggleFavorite(advertId) {
            $.ajax({
                url: '@Url.Action("ToggleFavorite", "Account")',
                type: 'POST',
                data: {
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
                    advertId: advertId
                },
                success: function (response) {
                    
                    Swal.fire({
                        position: 'top-end',          
                        icon: 'success',               
                        title: 'İlan favorilerime eklendi!',
                        showConfirmButton: false,     
                        timer: 1500,                  
                        toast: true                   
                    });
                },
                error: function (xhr) {
                    
                    if (xhr.status === 401) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Giriş Yapmalısınız',
                            text: 'Favorilerime eklemek için lütfen giriş yapın.',
                            confirmButtonText: 'Tamam'
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Hata!',
                            text: 'İlan zaten favorilerime eklenmiş.',
                            toast: true,
                            position: 'top-end',
                            timer: 3000,
                            showConfirmButton: false
                        });
                    }
                }
            });
        }
    </script>
}