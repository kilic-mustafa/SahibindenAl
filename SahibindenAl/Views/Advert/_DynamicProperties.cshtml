@model List<CategoryPropertyKey>
    
@{
    var existingValues = ViewBag.ExistingValues as List<SahibindenAl.Models.AdvertPropertyValue>;
}

<!-- Debug info -->
<!-- Model count: @Model?.Count ?? 0 -->

@if (Model != null && Model.Count > 0)
{
    <h5 class="mt-4 mb-3 text-primary">Detaylı Özellikler</h5>
    <div class="row">
        @foreach (var prop in Model.Where(p => p != null))
        {
            if (prop.Name == null) continue;
            
            var savedValue = existingValues?.FirstOrDefault(v => v.CategoryPropertyKeyId == prop.Id)?.Value;

            <div class="col-md-6 mb-3" id="prop-container-@prop.Id">
                <label class="form-label fw-bold">@prop.Name</label>
                <!-- Debug: DataType=@prop.DataType, Options Count=@(prop.CategoryPropertyOptions?.Count ?? 0) -->

                @if (prop.DataType == "Number")
                {
                    <input type="number" name="PropertyValues[@prop.Id]" value="@savedValue" class="form-control" />
                }
                else if (prop.DataType == "Select")
                {
                    <select name="PropertyValues[@prop.Id]" class="form-select">
                        <option value="">Seçiniz</option>
                        @if (prop.CategoryPropertyOptions != null)
                        {
                            @foreach (var option in prop.CategoryPropertyOptions)
                            {
                                if (option != null && option.Value != null)
                                {
                                    @if (savedValue == option.Value)
                                    {
                                        <option value="@option.Value" selected>@option.Value</option>
                                    }
                                    else
                                    {
                                        <option value="@option.Value">@option.Value</option>
                                    }
                                }
                            }
                        }
                        else
                        {
                            <option disabled>Seçenek yok</option>
                        }
                    </select>
                }
                else
                {
                    <input type="text" name="PropertyValues[@prop.Id]" value="@savedValue" class="form-control" />
                }
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info mt-3">
        <i class="fa fa-info-circle"></i> Bu kategori için özel özellikler tanımlanmamıştır.
    </div>
}
