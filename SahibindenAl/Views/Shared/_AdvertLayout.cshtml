@using SahibindenAl.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<User> UserManager
@inject SignInManager<User> SignInManager

@{

    var filter = ViewBag.CurrentFilter as SahibindenAl.DTOs.AdvertFilterDto;

}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1200, initial-scale=1, shrink-to-fit=no" />    
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SahibindenAl.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
<header>
    <nav class="navbar navbar-expand navbar-toggleable-sm border-bottom box-shadow mb-3" style="background-color: #363F54;">
        <div class="container">
            
            <a class="navbar-brand d-flex align-items-center justify-content-center" asp-area="" asp-controller="Home" asp-action="Index" 
               style="background-color: #FFE800; color: black; font-weight: bold; font-family: Arial, sans-serif; font-size: 20px; padding: 0px 10px; height: 36px; text-decoration: none; margin-left: 13px;">
                sahibindenal.com
            </a>

            <ul class="navbar-nav align-items-center ms-auto">
                @if (SignInManager.IsSignedIn(User))
                {
                    var currentUser = await UserManager.GetUserAsync(User);

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-white fw-bold" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 12px;">
                            @($"{currentUser!.FirstName} {currentUser.LastName!.First()}.".ToUpper())
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown" style="min-width: 220px;">

                            <li><span class="dropdown-header text-secondary fw-bold fw-bold fs-6 ps-3">@($"{currentUser!.FirstName} {currentUser!.LastName}".ToUpper())</span></li>
                            <li><hr class="dropdown-divider"></li>

                            <li><a class="dropdown-item text-black" asp-controller="Account" asp-action="AccountSettings">Hesap Ayarları</a></li>
                            <li><hr class="dropdown-divider"></li>

                            <li><a class="dropdown-item text-black" asp-controller="Advert" asp-action="MyAdverts">İlanlarım</a></li>
                            <li><hr class="dropdown-divider"></li>

                            <li><a class="dropdown-item text-black" asp-controller="Account" asp-action="MyFavorites">Favorilerim</a></li>
                            <li><hr class="dropdown-divider"></li>

                            <li>
                                <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item">➜] Çıkış Yap</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                    }
                </ul>

            </div>
        </div>
    </nav>
</header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>s

    <footer class="border-top footer text-muted py-0">
        <div class="container">
            
            <div class="d-flex flex-wrap justify-content-between align-items-center">

                <div>
                    Copyright &copy; 2025 sahibindenal.com
                </div>
                
                <div class="d-flex flex-wrap gap-4">
                    <a href="#" class="text-muted text-decoration-none">Şartlar ve Koşullar</a>
                    <a href="#" class="text-muted text-decoration-none">Reklam Politikası</a>
                    <a href="#" class="text-muted text-decoration-none">Resmi Kurumlar için Kılavuz</a>
                    <a href="#" class="text-muted text-decoration-none">Gizlilik Bildirimi</a>
                    <a href="#" class="text-muted text-decoration-none">Çerez Ayarları</a>
                </div>

            </div>
        </div>
    </footer>
    
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
