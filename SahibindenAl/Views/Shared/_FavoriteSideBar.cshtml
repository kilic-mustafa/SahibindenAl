@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<div class="card shadow-sm border-0">
    <div class="list-group list-group-flush">
        <a asp-controller="Account" asp-action="MyFavorites" 
           class="list-group-item list-group-item-action @(currentAction == "MyFavorites" ? "active" : "")">
            <i class="bi bi-heart me-2"></i> Favori İlanlar
        </a>
        <a asp-controller="SavedSearch" asp-action="Index" 
           class="list-group-item list-group-item-action @(currentAction == "Index" ? "active" : "")">
            <i class="bi bi-search me-2"></i> Favori Aramalar
        </a>
    </div>
</div>

<style>
    .list-group-item.active {
        background-color: #f8f9fa !important;
        color: #007bff !important;
        border-left: 4px solid #007bff;
        font-weight: bold;
    }
    .list-group-item {
        border: none;
        padding: 12px 20px;
        color: #666;
    }
</style>